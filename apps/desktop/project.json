{
  "name": "desktop",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/desktop/src",
  "projectType": "application",
  "targets": {
    "build-preload": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/desktop",
        "main": "apps/desktop/src/bridge.ts",
        "tsConfig": "apps/desktop/tsconfig.preload.json"
      }
    },
    "move-preload": {
      "executor": "nx:run-commands",
      "outputs": [],
      "dependsOn": ["build-preload"],
      "options": {
        "command": "if [ -f dist/apps/desktop/src/bridge.js ]; then mv dist/apps/desktop/src/bridge.js dist/apps/desktop/bridge.js; fi && if [ -f dist/apps/desktop/src/bridge.js.map ]; then mv dist/apps/desktop/src/bridge.js.map dist/apps/desktop/bridge.js.map; fi"
      }
    },
    "build": {
      "executor": "nx-electron:build",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["move-preload"],
      "options": {
        "outputPath": "dist/apps/desktop",
        "main": "apps/desktop/src/main.ts",
        "tsConfig": "apps/desktop/tsconfig.app.json",
        "assets": ["apps/desktop/src/assets"]
      },
      "configurations": {
        "production": {
          "optimization": true,
          "extractLicenses": true,
          "inspect": false,
          "fileReplacements": [
            {
              "replace": "apps/desktop/src/environments/environment.ts",
              "with": "apps/desktop/src/environments/environment.prod.ts"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "nx-electron:execute",
      "options": {
        "buildTarget": "desktop:build"
      },
      "dependsOn": ["move-preload"]
    },
    "package": {
      "executor": "nx-electron:package",
      "options": {
        "name": "desktop",
        "frontendProject": "client",
        "sourcePath": "dist/apps",
        "outputPath": "dist/packages",
        "prepackageOnly": true
      }
    },
    "make": {
      "executor": "nx-electron:make",
      "options": {
        "name": "desktop",
        "frontendProject": "client",
        "sourcePath": "dist/apps",
        "outputPath": "dist/executables"
      }
    },
    "lint": {
      "command": "eslint apps/desktop/**/*.ts"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/desktop/jest.config.ts"
      }
    }
  }
}
